{
  "name": "amu-http",
  "version": "1.1.1",
  "description": "A graceful, lightweight HTTP client built on Fetch.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lahin31/amu-http.git"
  },
  "homepage": "https://github.com/lahin31/amu-http#readme",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck.only",
    "size": "size-limit",
    "bench": "vitest bench --run",
    "verify": "publint && attw --pack",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm run verify && npm run size",
    "prepare": "simple-git-hooks",
    "test:examples": "npm run example:get",
    "example:get": "npm run build && tsx examples/get-users.ts",
    "example:post": "npm run build && tsx examples/create-post.ts",
    "example:bearer": "npm run build && tsx examples/bearer-token.ts",
    "example:retry:safe": "npm run build && tsx examples/retry-safe-default.ts",
    "example:retry:advanced": "npm run build && tsx examples/retry-advanced.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "biome check --write --no-errors-on-unmatched"
  },
  "keywords": [
    "http",
    "fetch",
    "amu",
    "amayra",
    "lightweight"
  ],
  "author": "Technext",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "size-limit": [
    {
      "name": "ESM (gzip)",
      "path": "dist/index.mjs",
      "limit": "2 KB",
      "gzip": true
    },
    {
      "name": "CJS (gzip)",
      "path": "dist/index.cjs",
      "limit": "2.1 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.13",
    "@changesets/cli": "^2.31.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.9.0",
    "lint-staged": "^16.4.0",
    "publint": "^0.3.18",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^12.1.0",
    "tinybench": "^6.0.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
