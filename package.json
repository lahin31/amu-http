{
  "name": "amu-http",
  "version": "2.0.0-alpha.0",
  "description": "The most type-safe HTTP client in JavaScript. Schema-inferred types, type-safe URL params, middleware-composable, universal.",
  "type": "module",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "sideEffects": false,
  "engines": {
    "node": ">=20.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lahin31/amu-http.git"
  },
  "homepage": "https://github.com/lahin31/amu-http#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./middleware/auth": {
      "types": "./dist/middleware/auth.d.mts",
      "default": "./dist/middleware/auth.mjs"
    },
    "./middleware/requestId": {
      "types": "./dist/middleware/requestId.d.mts",
      "default": "./dist/middleware/requestId.mjs"
    },
    "./middleware/logger": {
      "types": "./dist/middleware/logger.d.mts",
      "default": "./dist/middleware/logger.mjs"
    },
    "./middleware/otel": {
      "types": "./dist/middleware/otel.d.mts",
      "default": "./dist/middleware/otel.mjs"
    },
    "./middleware/cookies": {
      "types": "./dist/middleware/cookies.d.mts",
      "default": "./dist/middleware/cookies.mjs"
    },
    "./test": {
      "types": "./dist/test/mock.d.mts",
      "default": "./dist/test/mock.mjs"
    },
    "./forms": {
      "types": "./dist/forms/index.d.mts",
      "default": "./dist/forms/index.mjs"
    },
    "./pagination": {
      "types": "./dist/pagination/index.d.mts",
      "default": "./dist/pagination/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "clean": "rm -rf dist",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "vitest run --typecheck.only",
    "size": "size-limit",
    "bench": "vitest bench --run",
    "verify": "publint && attw --pack --ignore-rules cjs-resolves-to-esm no-resolution",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run build && npm run verify && npm run size",
    "prepare": "simple-git-hooks",
    "examples": "for f in examples/*.ts; do echo \"\\n— $f —\"; npx tsx \"$f\"; done",
    "example:get": "tsx examples/01-basic-get.ts",
    "example:schema": "tsx examples/02-schema-inference.ts",
    "example:params": "tsx examples/03-typed-url-params.ts",
    "example:body": "tsx examples/04-validated-body.ts",
    "example:errors": "tsx examples/05-discriminated-errors.ts",
    "example:retries": "tsx examples/06-retries.ts",
    "example:auth": "tsx examples/07-middleware-auth.ts",
    "example:sse": "tsx examples/08-streaming-sse.ts",
    "example:ndjson": "tsx examples/09-streaming-ndjson.ts",
    "example:mock": "tsx examples/10-mock-client-testing.ts",
    "example:extend": "tsx examples/11-extend-and-forms.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,js,json,md}": "biome check --write --no-errors-on-unmatched"
  },
  "keywords": [
    "http",
    "fetch",
    "client",
    "typescript",
    "type-safe",
    "schema",
    "zod",
    "valibot",
    "arktype",
    "standard-schema",
    "middleware",
    "universal",
    "edge",
    "node",
    "browser"
  ],
  "author": "Technext",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "core (createClient only)",
      "path": "dist/index.mjs",
      "import": "{ createClient }",
      "limit": "3.5 KB",
      "gzip": true
    },
    {
      "name": "with all errors imported",
      "path": "dist/index.mjs",
      "import": "{ createClient, AmuError, AmuNetworkError, AmuUrlError, AmuValidationError, AmuUnknownError }",
      "limit": "3.5 KB",
      "gzip": true
    },
    {
      "name": "with SSE parser",
      "path": "dist/index.mjs",
      "import": "{ createClient, parseSSE }",
      "limit": "3.9 KB",
      "gzip": true
    },
    {
      "name": "with SSE + NDJSON parsers",
      "path": "dist/index.mjs",
      "import": "{ createClient, parseSSE, parseNDJSON }",
      "limit": "4.2 KB",
      "gzip": true
    },
    {
      "name": "full barrel (everything)",
      "path": "dist/index.mjs",
      "limit": "4.2 KB",
      "gzip": true
    }
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.13",
    "@changesets/cli": "^2.31.0",
    "@opentelemetry/api": "^1.9.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^20.9.0",
    "lint-staged": "^16.4.0",
    "publint": "^0.3.18",
    "simple-git-hooks": "^2.13.1",
    "size-limit": "^12.1.0",
    "tinybench": "^6.0.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4",
    "zod": "^3.25.0"
  }
}
