{
  "name": "amu-http",
  "version": "1.2.0",
  "description": "A graceful, lightweight HTTP client built on Fetch.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lahin31/amu-http.git"
  },
  "homepage": "https://github.com/lahin31/amu-http#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./require.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "require.cjs"
  ],
  "scripts": {
    "build": "tsup src/index.ts --tsconfig tsconfig.build.json --format cjs,esm --dts --minify --clean --outDir dist",
    "dev": "tsup src/index.ts --tsconfig tsconfig.build.json --format cjs,esm --watch --dts --outDir dist",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run lint && npm run build",
    "test:examples": "npm run example:get",
    "example:get": "npm run build && node examples/get-users.js",
    "example:post": "npm run build && node examples/create-post.js",
    "example:bearer": "npm run build && node examples/bearer-token.js",
    "example:retry:safe": "npm run build && node examples/retry-safe-default.js",
    "example:retry:advanced": "npm run build && node examples/retry-advanced.js",
    "release": "standard-version && git push --follow-tags",
    "publish": "npm publish",
    "release:patch": "standard-version --release-as patch && git push --follow-tags && npm publish",
    "release:minor": "standard-version --release-as minor && git push --follow-tags && npm publish",
    "release:major": "standard-version --release-as major && git push --follow-tags && npm publish"
  },
  "keywords": [
    "http",
    "fetch",
    "amu",
    "amayra",
    "lightweight"
  ],
  "author": "lahin31",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "standard-version": "^9.5.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^1.6.0"
  }
}
